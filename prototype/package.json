{
  "name": "prototype",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @internal/console",
    "build": "npm run build -w @internal/console",
    "start": "npm run start -w @internal/console",
    "lint": "eslint apps packages",
    "test": "vitest run",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:reset": "npm run db:reset -w @internal/console"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
